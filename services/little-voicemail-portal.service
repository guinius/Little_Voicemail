[Unit]
Description=Little Voicemail setup portal (WiFi onboarding, http->https)
After=NetworkManager.service
Wants=NetworkManager.service
# Port 80 has one owner. Starting before the web UI keeps the two from
# racing for the bind on a slow boot.
Before=little-voicemail-web.service

[Service]
Type=simple
User=voicemail
Group=voicemail

WorkingDirectory=/opt/little-voicemail
ExecStart=/opt/little-voicemail/.venv/bin/python -m src.web.portal
Environment=PYTHONUNBUFFERED=1
Environment=LV_CONFIG=/etc/little-voicemail/config.json
Environment=LV_DATA_DIR=/var/lib/little-voicemail

# Binding port 80 needs this one capability. Raising the access point and
# joining a network go through sudo and the lv-netctl helper, which is why
# NoNewPrivileges has to stay off. CapabilityBoundingSet is deliberately left
# unset (full set): setting it here would also cap what sudo's re-exec can
# hold once it escalates to root, and sudo needs CAP_SETUID/CAP_SETGID just
# to get there in the first place - a bounding set of only
# CAP_NET_BIND_SERVICE makes every sudo call fail with "unable to change to
# root gid". The sudoers rule already limits root access to `/sbin/reboot`
# and the fixed-verb lv-netctl helper, so this is not an open door.
AmbientCapabilities=CAP_NET_BIND_SERVICE

Restart=always
RestartSec=5

NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/little-voicemail

[Install]
WantedBy=multi-user.target
