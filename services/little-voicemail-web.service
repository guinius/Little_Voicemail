[Unit]
Description=Little Voicemail parent web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=voicemail
Group=voicemail

WorkingDirectory=/opt/little-voicemail
ExecStart=/opt/little-voicemail/.venv/bin/python -m src.web.server
Environment=PYTHONUNBUFFERED=1
Environment=LV_CONFIG=/etc/little-voicemail/config.json
Environment=LV_DATA_DIR=/var/lib/little-voicemail
# Linking a Signal account runs signal-cli from here, so this process needs
# to know where signal-cli keeps its state.
Environment=LV_SIGNAL_CONFIG=/var/lib/little-voicemail/signal-cli
# The setup portal owns port 80: it serves the WiFi onboarding page there as
# well as the redirect, and only one process can hold the bind.
Environment=LV_HTTP_REDIRECT=0

# Applying an update needs to write into the checkout. The capability is kept
# for installs without the portal, where this process still binds port 80.
# CapabilityBoundingSet is deliberately left unset (full set): this process
# also shells out through sudo (signal_link.py, updater.py, app.py - restart,
# reboot, re-joining WiFi), and capping the bounding set here caps what sudo
# can escalate to as well, breaking every one of those calls with "unable to
# change to root gid". The sudoers rule already limits root access to a fixed
# set of commands, so leaving this unset is not an open door.
AmbientCapabilities=CAP_NET_BIND_SERVICE

Restart=always
RestartSec=5

NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/little-voicemail /etc/little-voicemail /opt/little-voicemail

[Install]
WantedBy=multi-user.target
