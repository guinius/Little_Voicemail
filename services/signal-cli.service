[Unit]
Description=signal-cli JSON-RPC daemon for Little Voicemail
Documentation=https://github.com/AsamK/signal-cli/wiki/JSON-RPC-service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Attachments are written here and read back by the phone service, so both
# run as the same user.
User=voicemail
Group=voicemail

EnvironmentFile=/etc/little-voicemail/signal.env
# Without an account there is nothing to run, and Restart=always would turn
# that into a crash loop every ten seconds forever. A failed ExecCondition
# marks the unit skipped rather than failed and does not trigger a restart,
# so the unit is safe to leave enabled between unlinking and relinking.
ExecCondition=/usr/bin/test -n "${SIGNAL_ACCOUNT}"
# --config here is the account data directory (keys, password, message
# store) - do not also set a SIGNAL_CLI_CONFIG environment variable
# pointing at this same path. That variable is a different thing entirely:
# signal-cli treats it as a JSON *file* of CLI-option defaults, so pointing
# it at a directory makes every startup fail with "Failed to load config
# from <path>: <path> (Is a directory)".
ExecStart=/usr/local/bin/signal-cli \
    --config /var/lib/little-voicemail/signal-cli \
    -a ${SIGNAL_ACCOUNT} \
    daemon --tcp 127.0.0.1:7583 --receive-mode on-start

Restart=always
RestartSec=10

# The daemon only ever talks to Signal's servers and the local socket.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/little-voicemail
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
